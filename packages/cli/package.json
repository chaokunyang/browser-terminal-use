{
  "name": "@browser-terminal-use/cli",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaokunyang/browser-terminal-use",
    "directory": "packages/cli"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "browterm": "dist/index.js"
  },
  "scripts": {
    "build": "npm run build --workspace @browser-terminal-use/core && tsc -p tsconfig.json",
    "dev": "npm run build --workspace @browser-terminal-use/core && tsx watch src/index.ts",
    "test": "vitest run",
    "lint": "npm run build --workspace @browser-terminal-use/core && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@browser-terminal-use/core": "^0.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
